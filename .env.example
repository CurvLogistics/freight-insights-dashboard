# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk login. The publishable key is public; the secret key is server-only (checks the admin role on sync/import).
# VITE_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
